@startuml casos-de-uso
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

title Sistema de Aluguel de Carros - Casos de Uso (v1)

actor "Usuário" as Usuario
actor "Cliente" as Cliente
actor "Agente" as Agente
actor "Empresa" as Empresa
actor "Banco" as Banco

Cliente -|> Usuario
Agente -|> Usuario
Empresa -|> Agente
Banco -|> Agente

rectangle "Sistema de Aluguel de Carros" {
  usecase "Realizar login" as UC01
  usecase "Cadastrar-se" as UC02
  usecase "Manter dados do cliente" as UC03
  usecase "Introduzir pedido de aluguel" as UC04
  usecase "Modificar pedido" as UC05
  usecase "Consultar pedido" as UC06
  usecase "Cancelar pedido" as UC07
  usecase "Avaliar pedido (análise financeira)" as UC08
  usecase "Executar contrato" as UC09
  usecase "Conceder contrato de crédito" as UC10
  usecase "Manter automóveis" as UC11
  usecase "Consultar clientes" as UC12
}

Usuario --> UC01
Usuario --> UC02

Cliente --> UC03
Cliente --> UC04
Cliente --> UC05
Cliente --> UC06
Cliente --> UC07

Agente --> UC05
Agente --> UC06
Agente --> UC08
Agente --> UC09
Agente --> UC11
Agente --> UC12

Banco --> UC10

UC09 .> UC10 : <<extend>>
UC04 .> UC01 : <<include>>
UC08 .> UC01 : <<include>>
@enduml
