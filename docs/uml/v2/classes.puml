@startuml classes
!pragma layout smetana
skinparam classAttributeIconSize 0
hide empty members

title Sistema de Aluguel de Carros - Diagrama de Classes (v2)

package br.pucminas.aluguelcarros.model {

abstract class Usuario {
  - id : Long
  - login : String
  - senha : String
  - nome : String
  - perfil : Perfil
}

class Cliente {
  + {static} MAX_RENDIMENTOS : int = 3
  - rg : String
  - cpf : String
  - profissao : String
  + adicionarRendimento(r : Rendimento) : void
  + substituirRendimentos(novos : List<Rendimento>) : void
}

class Endereco <<Embeddable>> {
  - logradouro : String
  - numero : String
  - bairro : String
  - cidade : String
  - uf : String
  - cep : String
}

class Rendimento {
  - id : Long
  - entidadeEmpregadora : String
  - valor : BigDecimal
}

abstract class Agente {
  - cnpj : String
}

class Empresa
class Banco

class Automovel {
  - id : Long
  - matricula : String
  - ano : Integer
  - marca : String
  - modelo : String
  - placa : String
  - valorDiaria : BigDecimal
  - tipoProprietario : TipoProprietario
  + registrarPropriedade(tipo : TipoProprietario, dono : Usuario) : void
}

class PedidoAluguel {
  - id : Long
  - dataInicio : LocalDate
  - dataFim : LocalDate
  - valorEstimado : BigDecimal
  - status : StatusPedido
  - parecer : String
  - criadoEm : LocalDateTime
  - atualizadoEm : LocalDateTime
  + {static} dias(inicio : LocalDate, fim : LocalDate) : long
  + alterarPeloCliente(a : Automovel, inicio : LocalDate, fim : LocalDate) : void
  + cancelar() : void
  + iniciarAnalise(agente : Agente) : void
  + alterarPeloAgente(inicio : LocalDate, fim : LocalDate, valor : BigDecimal) : void
  + avaliar(agente : Agente, aprovado : boolean, parecer : String) : void
  + marcarContratado() : void
  + pertenceA(login : String) : boolean
}

class Contrato {
  - id : Long
  - tipoProprietario : TipoProprietario
  - dataAssinatura : LocalDate
}

class ContratoCredito {
  - id : Long
  - valor : BigDecimal
  - taxaJuros : BigDecimal
  - numeroParcelas : Integer
  + valorParcela() : BigDecimal
}

enum Perfil {
  CLIENTE
  EMPRESA
  BANCO
}

enum StatusPedido {
  PENDENTE
  EM_ANALISE
  APROVADO
  REPROVADO
  CANCELADO
  CONTRATADO
  + podeSerCancelado() : boolean
}

enum TipoProprietario {
  CLIENTE
  EMPRESA
  BANCO
}

}

Usuario <|-- Cliente
Usuario <|-- Agente
Agente <|-- Empresa
Agente <|-- Banco

Cliente *-- "0..1" Endereco
Cliente "1" *-- "0..3" Rendimento : rendimentos

PedidoAluguel "0..*" --> "1" Cliente : cliente
PedidoAluguel "0..*" --> "1" Automovel : automovel
PedidoAluguel "0..*" --> "0..1" Agente : agenteAvaliador
Automovel "0..*" --> "0..1" Usuario : proprietario

Contrato "0..1" --> "1" PedidoAluguel : pedido
Contrato "0..*" --> "1" Agente : agente
Contrato "1" *-- "0..1" ContratoCredito : contratoCredito
ContratoCredito "0..*" --> "1" Banco : banco

Usuario ..> Perfil
PedidoAluguel ..> StatusPedido
Automovel ..> TipoProprietario
Contrato ..> TipoProprietario
@enduml
